{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/life-runtime.schema.json",
  "title": "LifeRuntime",
  "description": "Current execution state: task queue, status, evidence for one life instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_id",
    "life_id",
    "active_instance_id",
    "status",
    "queue_depth"
  ],
  "properties": {
    "runtime_id": {
      "type": "string",
      "pattern": "^rt_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "active_instance_id": {
      "type": "string",
      "pattern": "^inst_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "blocked",
        "sleeping",
        "repairing",
        "retired"
      ]
    },
    "current_task_id": {
      "type": "string",
      "maxLength": 160
    },
    "queue_depth": {
      "type": "integer",
      "minimum": 0
    },
    "last_tick_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    }
  }
}
