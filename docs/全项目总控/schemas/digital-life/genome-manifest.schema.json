{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/genome-manifest.schema.json",
  "title": "GenomeManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "genome_id",
    "life_id",
    "authority_id",
    "manifest_version",
    "atom_refs",
    "created_at"
  ],
  "properties": {
    "genome_id": {
      "type": "string",
      "pattern": "^genome_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^auth_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_mode": {
      "type": "string",
      "enum": [
        "public_cloud",
        "private_cloud",
        "offline_package",
        "local_candidate"
      ],
      "default": "offline_package"
    },
    "atom_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atom_id",
          "version",
          "level",
          "checksum",
          "required"
        ],
        "properties": {
          "atom_id": {
            "type": "string",
            "pattern": "^atom_[a-z0-9][a-z0-9_-]{7,95}$"
          },
          "atom_family_id": {
            "type": "string",
            "pattern": "^atomfam_[a-z0-9][a-z0-9_-]{7,95}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "level": {
            "type": "string",
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "required": {
            "type": "boolean"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        }
      }
    },
    "policy_pack_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "signature": {
      "type": "string",
      "minLength": 32
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
