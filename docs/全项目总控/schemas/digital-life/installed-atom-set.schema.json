{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/installed-atom-set.schema.json",
  "title": "InstalledAtomSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "install_set_id",
    "life_id",
    "instance_id",
    "genome_id",
    "runtime_node",
    "atoms",
    "verified_at"
  ],
  "properties": {
    "install_set_id": {
      "type": "string",
      "pattern": "^aset_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^inst_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "genome_id": {
      "type": "string",
      "pattern": "^genome_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "runtime_node": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atom_id",
          "version",
          "checksum",
          "install_status",
          "callable"
        ],
        "properties": {
          "atom_id": {
            "type": "string",
            "pattern": "^atom_[a-z0-9][a-z0-9_-]{7,95}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "install_status": {
            "type": "string",
            "enum": [
              "installed",
              "missing",
              "checksum_failed",
              "quarantined",
              "deprecated"
            ]
          },
          "callable": {
            "type": "boolean"
          },
          "runtime_binding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        }
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
