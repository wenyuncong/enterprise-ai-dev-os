{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/authority-profile.schema.json",
  "title": "AuthorityProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_id",
    "authority_type",
    "trust_zone",
    "public_key",
    "status",
    "created_at"
  ],
  "properties": {
    "authority_id": {
      "type": "string",
      "pattern": "^auth_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "authority_type": {
      "type": "string",
      "enum": [
        "public_cloud",
        "private_cloud",
        "offline_local"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "trust_zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "encoded"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "ed25519",
            "ecdsa-p256",
            "rsa-3072"
          ]
        },
        "encoded": {
          "type": "string",
          "minLength": 32
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "rotating",
        "retired"
      ]
    },
    "offline_capable": {
      "type": "boolean",
      "default": false
    },
    "parent_authority_id": {
      "type": "string",
      "pattern": "^auth_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "policy_pack_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
