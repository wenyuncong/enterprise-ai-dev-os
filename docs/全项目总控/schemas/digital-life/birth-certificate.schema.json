{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/birth-certificate.schema.json",
  "title": "BirthCertificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "birth_certificate_id",
    "life_id",
    "authority_id",
    "owner_id",
    "genome_id",
    "birth_mode",
    "issued_at",
    "signature"
  ],
  "properties": {
    "birth_certificate_id": {
      "type": "string",
      "pattern": "^birth_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^auth_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "genome_id": {
      "type": "string",
      "pattern": "^genome_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "birth_mode": {
      "type": "string",
      "enum": [
        "public_cloud",
        "private_cloud",
        "offline_local"
      ]
    },
    "initial_lifecycle_state": {
      "type": "string",
      "enum": [
        "draft_birth",
        "born"
      ],
      "default": "born"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "minLength": 32
    }
  }
}
