{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/delegation-grant.schema.json",
  "title": "DelegationGrant",
  "description": "Scoped, time-bound authorization from a human or runtime authority to an agent or executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "grantor",
    "grantee",
    "project_id",
    "scope",
    "risk_level",
    "issued_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^grant_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "grantor": {
      "$ref": "#/$defs/actor"
    },
    "grantee": {
      "$ref": "#/$defs/actor"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_ids",
        "allowed_actions"
      ],
      "properties": {
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "analyze",
              "propose",
              "sandbox_execute",
              "execute",
              "promote"
            ]
          },
          "uniqueItems": true
        },
        "resource_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "uniqueItems": true
        },
        "task_id": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "confirmation_required": {
      "type": "boolean",
      "default": false
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "revocation_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "signature": {
      "type": "string",
      "minLength": 32
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "runtime",
            "service"
          ]
        },
        "identity_ref": {
          "type": "string",
          "maxLength": 320
        }
      }
    }
  }
}
