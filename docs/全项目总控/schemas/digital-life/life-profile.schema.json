{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/life-profile.schema.json",
  "title": "LifeProfile",
  "description": "Learning history, capability maturity, preferences, and growth record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "life_id",
    "capability_scores",
    "growth_stage",
    "created_at"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^prof_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "learning_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "uniqueItems": true
    },
    "capability_scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },
    "preferences": {
      "type": "object"
    },
    "evaluation_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "growth_stage": {
      "type": "string",
      "enum": [
        "newborn",
        "learning",
        "competent",
        "advanced",
        "expert",
        "master"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
