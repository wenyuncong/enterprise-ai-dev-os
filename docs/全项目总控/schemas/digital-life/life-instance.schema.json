{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/digital-life/life-instance.schema.json",
  "title": "LifeInstance",
  "description": "A running installation of a digital life on a specific node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "life_id",
    "authority_id",
    "node_id",
    "status",
    "installed_atom_set_id",
    "created_at"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^inst_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "life_id": {
      "type": "string",
      "pattern": "^life_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^auth_[a-z0-9][a-z0-9_-]{7,95}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioning",
        "active",
        "sleeping",
        "repairing",
        "migrating",
        "retired",
        "lost"
      ]
    },
    "runtime_locator": {
      "type": "string",
      "maxLength": 256
    },
    "installed_atom_set_id": {
      "type": "string",
      "pattern": "^iaset_[a-z0-9][a-z0-9_-]{15,95}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
