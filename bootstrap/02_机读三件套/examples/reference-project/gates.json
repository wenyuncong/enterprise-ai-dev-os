{
  "gates_version": "1.0.0",
  "_provenance": "示例门禁注册表：展示如何把「何时跑、跑什么、是否阻断、留什么证据」机读化。分层与字段为真实模板，命令与路径均为中立占位，采用项目应替换为自己的脚本。",
  "layers": [
    "static_audit",
    "contract_test",
    "consumer_test",
    "runtime_replay",
    "artifact_provenance",
    "delivery_governance",
    "environment"
  ],
  "rollout_policy": {
    "default_severity": "warn",
    "blocking_paths": [
      "核心单据路径 A",
      "核心单据路径 B"
    ],
    "promotion_rule": "静态审计先以 WARN 报告，确认误报率后对核心单据路径升级为阻断；契约类与制品类门禁自始阻断"
  },
  "gates": [
    {
      "id": "G-DOC-STATUS-ACTION",
      "title": "单据状态轴与动作一致性（前端是否在端侧拼业务按钮）",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "<项目状态动作审计脚本>",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/"], "change_types": ["B", "E", "U"] },
      "evidence": { "kind": "exit_code", "freshness_rule": "必须在最后一次相关改动之后运行" },
      "owner": "project",
      "notes": "覆盖状态轴 fallback、底部后端动作门禁、端侧拼接动作"
    },
    {
      "id": "G-DOC-BACKEND-CAPABILITY",
      "title": "单据后端能力与 Provider 覆盖",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "<项目后端能力审计脚本>",
      "severity": "error",
      "blocking": false,
      "applies_to": { "paths": ["backend/"], "change_types": ["B", "E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "项目领域审计族"
    },
    {
      "id": "G-DOC-RUNTIME-CONSUMERS",
      "title": "单据运行态消费者（AI/MCP 等入口是否走统一命令路径）",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "<项目运行态消费者审计脚本>",
      "severity": "error",
      "blocking": false,
      "applies_to": { "paths": ["backend/", "frontend/"], "change_types": ["B", "E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "架构风险评估中的缺口核验脚本"
    },
    {
      "id": "G-FIELDPACKAGE-COVERAGE",
      "title": "字段包覆盖",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "<项目字段包覆盖审计脚本>",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/", "database/"], "change_types": ["E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "项目领域审计族"
    },
    {
      "id": "G-CONTRACT-REGISTRY",
      "title": "后端契约：注册表 / 能力 / 运行态 / Provider / 历史动作集合一致",
      "layer": "contract_test",
      "when": ["pre_commit", "pre_push"],
      "command": "<项目契约测试命令>",
      "severity": "error",
      "blocking": true,
      "applies_to": { "paths": ["backend/"], "change_types": ["B", "E", "U", "N"] },
      "evidence": { "kind": "exit_code", "freshness_rule": "契约测试须在最后一次改动后重跑" },
      "owner": "project",
      "notes": "具体测试选择器由项目构建配置决定，不写入模板"
    },
    {
      "id": "G-CONSUMER-FRONTEND",
      "title": "前端消费约束：页面只渲染后端动作，接口失败不恢复业务 fallback",
      "layer": "consumer_test",
      "when": ["pre_commit", "pre_push"],
      "command": "<项目前端测试命令>",
      "severity": "error",
      "blocking": true,
      "applies_to": { "paths": ["frontend/"], "change_types": ["B", "E", "U", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "notes": "种子数据只用于验证展示，不得成为前端业务判定依据"
    },
    {
      "id": "G-BUSINESS-FLOW-API",
      "title": "核心业务流程 API 门禁",
      "layer": "contract_test",
      "when": ["pre_push", "on_demand"],
      "command": "<项目核心业务流程 API 门禁脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project"
    },
    {
      "id": "G-RUNTIME-REPLAY",
      "title": "运行态回放：登录指定租户 -> 详情/画像/动作/命令 -> 回读状态与关联结果，并记录制品版本",
      "layer": "runtime_replay",
      "when": ["pre_release", "on_demand"],
      "command": "<项目回放脚本>",
      "severity": "error",
      "blocking": true,
      "applies_to": { "change_types": ["B", "E"], "risk_levels": ["L2", "L3"] },
      "evidence": { "kind": "api_response", "path": "证据目录", "freshness_rule": "客户问题与发布前必跑，且必须记录制品指纹" },
      "owner": "project",
      "notes": "回放必须使用真实租户，且不得直改库"
    },
    {
      "id": "G-ARTIFACT-PROVENANCE",
      "title": "制品指纹：源码提交、构建产物、运行版本一致",
      "layer": "artifact_provenance",
      "when": ["pre_release", "post_deploy"],
      "command": "<项目制品指纹门禁脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "file", "freshness_rule": "发布前阻断，防止「代码已改、运行仍旧」" },
      "owner": "project"
    },
    {
      "id": "G-DB-GATE",
      "title": "测试库门禁",
      "layer": "environment",
      "when": ["pre_push", "pre_release"],
      "command": "<项目测试库门禁脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "db_readback" },
      "owner": "project"
    },
    {
      "id": "G-PROD-MIGRATION",
      "title": "生产迁移后校验",
      "layer": "environment",
      "when": ["pre_release", "post_deploy"],
      "command": "<项目生产迁移后校验脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "db_readback" },
      "owner": "project"
    },
    {
      "id": "G-PUBLIC-SMOKE",
      "title": "生产公开面冒烟",
      "layer": "environment",
      "when": ["post_deploy"],
      "command": "<项目生产公开面冒烟脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "api_response" },
      "owner": "project"
    },
    {
      "id": "G-INIT-BASELINE",
      "title": "系统初始化基线",
      "layer": "environment",
      "when": ["on_demand", "pre_release"],
      "command": "<项目初始化基线门禁脚本>",
      "severity": "warn",
      "blocking": false,
      "evidence": { "kind": "exit_code" },
      "owner": "project"
    },
    {
      "id": "G-FRONTEND-BUDGET",
      "title": "前端包体积预算",
      "layer": "static_audit",
      "when": ["pre_commit", "pre_push"],
      "command": "<项目前端包体积预算脚本>",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/"] },
      "evidence": { "kind": "json" },
      "owner": "project"
    },
    {
      "id": "G-KNOWLEDGE-GOVERNANCE",
      "title": "知识治理：核心真相代码变更必须同步知识专题，或声明 Knowledge-Impact: none 并给出理由",
      "layer": "delivery_governance",
      "when": ["pre_commit", "pre_push"],
      "command": "<项目知识治理脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project"
    },
    {
      "id": "G-ARCHITECTURE-IMPACT",
      "title": "架构影响声明",
      "layer": "delivery_governance",
      "when": ["pre_commit", "pre_push"],
      "command": "<项目架构影响脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project"
    },
    {
      "id": "G-RELEASE-MANIFEST",
      "title": "发布迁移清单与发布脚本覆盖",
      "layer": "delivery_governance",
      "when": ["pre_release"],
      "command": "<项目发布清单脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "file" },
      "owner": "project"
    },
    {
      "id": "G-5S-ENTER",
      "title": "5S 会话接管（新会话/恢复会话/切换目标后，任何写操作之前）",
      "layer": "delivery_governance",
      "when": ["session_start", "before_write"],
      "command": "<项目 5S 接管脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "notes": "脚本会校验分支非 detached、远端可达、本地 HEAD 与远端一致；远端不可达时拒绝开工"
    },
    {
      "id": "G-5S-CLOSE",
      "title": "5S 会话关闭（精确暂存 + 提交 + 推送 + 关闭判据）",
      "layer": "delivery_governance",
      "when": ["pre_push", "pre_release"],
      "command": "<项目 5S 关闭脚本>",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code", "freshness_rule": "只有输出 FIVE_S_DELIVERY_CLOSE=PASS 才可称「完成」" },
      "owner": "project"
    }
  ]
}
