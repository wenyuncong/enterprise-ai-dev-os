{
  "gates_version": "1.0.0",
  "_provenance": "由母版「模型无关的约束方案」六层门禁表 + scripts/ci 与 scripts/ps1 实际脚本清单抽取；命令为母版真实入口",
  "layers": [
    "static_audit",
    "contract_test",
    "consumer_test",
    "runtime_replay",
    "artifact_provenance",
    "delivery_governance",
    "environment"
  ],
  "rollout_policy": {
    "default_severity": "warn",
    "blocking_paths": [
      "采购入库",
      "采购退货",
      "销售出库",
      "销售退货"
    ],
    "promotion_rule": "静态审计先以 WARN 报告，确认误报率后对核心单据路径升级为阻断；契约类与制品类门禁自始阻断"
  },
  "gates": [
    {
      "id": "G-DOC-STATUS-ACTION",
      "title": "单据状态轴与动作一致性（前端是否在端侧拼业务按钮）",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "pwsh scripts/ps1/audit-document-status-action-truth.ps1",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/gerp-web/"], "change_types": ["B", "E", "U"] },
      "evidence": { "kind": "exit_code", "freshness_rule": "必须在最后一次相关改动之后运行" },
      "owner": "project",
      "provenance": "母版 P1-A 首批落地（本地审计输出 FAIL=0 / WARN=0）",
      "notes": "覆盖四个表单：状态轴 fallback、底部后端动作门禁、端侧拼接「红冲并复制」"
    },
    {
      "id": "G-DOC-BACKEND-CAPABILITY",
      "title": "单据后端能力与 Provider 覆盖",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "pwsh scripts/ps1/audit-document-backend-capabilities.ps1",
      "severity": "error",
      "blocking": false,
      "applies_to": { "paths": ["backend/"], "change_types": ["B", "E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版领域审计族"
    },
    {
      "id": "G-DOC-RUNTIME-CONSUMERS",
      "title": "单据运行态消费者（AI/MCP 等入口是否走统一命令路径）",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "pwsh scripts/ps1/audit-document-runtime-consumers.ps1",
      "severity": "error",
      "blocking": false,
      "applies_to": { "paths": ["backend/", "frontend/"], "change_types": ["B", "E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 GERP 架构风险评估中的 P0-2 缺口核验脚本"
    },
    {
      "id": "G-FIELDPACKAGE-COVERAGE",
      "title": "字段包覆盖",
      "layer": "static_audit",
      "when": ["pre_commit", "on_demand"],
      "command": "pwsh scripts/ps1/audit-document-fieldpackage-coverage.ps1",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/", "database/"], "change_types": ["E", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版领域审计族"
    },
    {
      "id": "G-CONTRACT-REGISTRY",
      "title": "后端契约：Registry / Capability / RuntimeProfile / Provider / HistoryActionView 动作集合一致",
      "layer": "contract_test",
      "when": ["pre_commit", "pre_push"],
      "command": "mvn -q test -Dtest=<项目契约测试选择器>",
      "severity": "error",
      "blocking": true,
      "applies_to": { "paths": ["backend/"], "change_types": ["B", "E", "U", "N"] },
      "evidence": { "kind": "exit_code", "freshness_rule": "契约测试须在最后一次改动后重跑" },
      "owner": "project",
      "provenance": "母版实测：后端两组契约测试共 72 项通过",
      "notes": "具体测试选择器由项目 pom 决定，不写入模板"
    },
    {
      "id": "G-CONSUMER-FRONTEND",
      "title": "前端消费约束：Host / Footer / List 只渲染后端动作，接口失败不恢复业务 fallback",
      "layer": "consumer_test",
      "when": ["pre_commit", "pre_push"],
      "command": "npx vitest run",
      "severity": "error",
      "blocking": true,
      "applies_to": { "paths": ["frontend/"], "change_types": ["B", "E", "U", "N"] },
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版实测：前端 Vitest 59 项 / 37 项通过（分模块）",
      "notes": "种子数据只用于验证展示，不得成为前端业务判定依据"
    },
    {
      "id": "G-BUSINESS-FLOW-API",
      "title": "核心业务流程 API 门禁",
      "layer": "contract_test",
      "when": ["pre_push", "on_demand"],
      "command": "bash scripts/ci/check-core-business-flow-api-gate.sh",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 scripts/ci"
    },
    {
      "id": "G-RUNTIME-REPLAY",
      "title": "运行态回放：登录指定租户 -> 详情/画像/动作/命令 -> 回读状态与关联结果，并记录制品版本",
      "layer": "runtime_replay",
      "when": ["pre_release", "on_demand"],
      "command": "pwsh scripts/ps1/<项目回放脚本>.ps1",
      "severity": "error",
      "blocking": true,
      "applies_to": { "change_types": ["B", "E"], "risk_levels": ["L2", "L3"] },
      "evidence": { "kind": "api_response", "path": "docs/发布闭环/.../evidence/", "freshness_rule": "客户问题与发布前必跑，且必须记录制品指纹" },
      "owner": "project",
      "provenance": "母版 2026-08-29 运行态回放：采购退货 id=9、销售退货 id=5，状态轴与审批轴分离已核实",
      "notes": "回放必须使用真实租户，且不得直改库"
    },
    {
      "id": "G-ARTIFACT-PROVENANCE",
      "title": "制品指纹：源码提交、编译产物、运行 JAR 版本一致",
      "layer": "artifact_provenance",
      "when": ["pre_release", "post_deploy"],
      "command": "bash scripts/ci/check-test-server-runtime-provenance.sh",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "file", "freshness_rule": "发布前阻断，防止「代码已改、运行仍旧」" },
      "owner": "project",
      "provenance": "母版 scripts/ci + 带 provenance 的单体 JAR 回放记录（记录 SHA256 与提交号）"
    },
    {
      "id": "G-DB-GATE",
      "title": "测试库门禁",
      "layer": "environment",
      "when": ["pre_push", "pre_release"],
      "command": "bash scripts/ci/check-test-server-db-gate.sh",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "db_readback" },
      "owner": "project",
      "provenance": "母版 scripts/ci（29.4 KB 环境门禁）"
    },
    {
      "id": "G-PROD-MIGRATION",
      "title": "生产迁移后校验",
      "layer": "environment",
      "when": ["pre_release", "post_deploy"],
      "command": "bash scripts/ci/check-production-db-post-migration.sh",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "db_readback" },
      "owner": "project",
      "provenance": "母版 scripts/ci"
    },
    {
      "id": "G-PUBLIC-SMOKE",
      "title": "生产公开面冒烟",
      "layer": "environment",
      "when": ["post_deploy"],
      "command": "py scripts/ci/check-production-public-smoke.py",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "api_response" },
      "owner": "project",
      "provenance": "母版 scripts/ci"
    },
    {
      "id": "G-INIT-BASELINE",
      "title": "系统初始化基线",
      "layer": "environment",
      "when": ["on_demand", "pre_release"],
      "command": "bash scripts/ci/check-system-initialization-baseline-gate.sh",
      "severity": "warn",
      "blocking": false,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 scripts/ci"
    },
    {
      "id": "G-FRONTEND-BUDGET",
      "title": "前端包体积预算",
      "layer": "static_audit",
      "when": ["pre_commit", "pre_push"],
      "command": "node scripts/ci/check-frontend-bundle-budget.mjs",
      "severity": "warn",
      "blocking": false,
      "applies_to": { "paths": ["frontend/"] },
      "evidence": { "kind": "json" },
      "owner": "project",
      "provenance": "母版 scripts/ci"
    },
    {
      "id": "G-KNOWLEDGE-GOVERNANCE",
      "title": "知识治理：核心真相代码变更必须同步知识专题，或声明 Knowledge-Impact: none 并给出理由",
      "layer": "delivery_governance",
      "when": ["pre_commit", "pre_push"],
      "command": "py scripts/ci/check_knowledge_governance.py",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 scripts/ci + 规则文件中的知识治理条（含 knowledge_impact_map.toml 数据驱动）"
    },
    {
      "id": "G-ARCHITECTURE-IMPACT",
      "title": "架构影响声明",
      "layer": "delivery_governance",
      "when": ["pre_commit", "pre_push"],
      "command": "py scripts/ci/check_architecture_impact.py",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 scripts/ci + architecture_impact_map.toml"
    },
    {
      "id": "G-RELEASE-MANIFEST",
      "title": "发布迁移清单与发布脚本覆盖",
      "layer": "delivery_governance",
      "when": ["pre_release"],
      "command": "py scripts/ci/check-release-migration-manifest.py",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "file" },
      "owner": "project",
      "provenance": "母版 scripts/ci（另有 check-release-script-coverage.py 配套）"
    },
    {
      "id": "G-5S-ENTER",
      "title": "5S 会话接管（新会话/恢复会话/切换目标后，任何写操作之前）",
      "layer": "delivery_governance",
      "when": ["session_start", "before_write"],
      "command": "pwsh scripts/ps1/enter-5s-delivery-session.ps1 -Mode Inspect",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code" },
      "owner": "project",
      "provenance": "母版 5S 脚本族；写模式需带 -ChangeType/-TargetVersion/-AffectedFlow/-Gate",
      "notes": "脚本会校验分支非 detached、双远端可达、本地 HEAD 与远端一致；远端不可达时拒绝开工"
    },
    {
      "id": "G-5S-CLOSE",
      "title": "5S 会话关闭（精确暂存 + 提交 + 双远端推送 + 关闭判据）",
      "layer": "delivery_governance",
      "when": ["pre_push", "pre_release"],
      "command": "pwsh scripts/ps1/close-5s-delivery-session.ps1",
      "severity": "error",
      "blocking": true,
      "evidence": { "kind": "exit_code", "freshness_rule": "只有输出 FIVE_S_DELIVERY_CLOSE=PASS 才可称「完成」" },
      "owner": "project",
      "provenance": "母版 5S 脚本族"
    }
  ]
}
