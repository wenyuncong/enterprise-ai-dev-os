{
  "routing_version": "1.0.0",
  "_provenance": "由母版规则文件中的「任务类型 → 预加载的规则/技能映射表」与 docs/项目知识体系/00_任务路由索引.md 抽取并结构化；内容为母版真实映射，未做增补",
  "precedence": ["project_rules", "tech_skill", "domain_skill", "handbook"],
  "defaults": {
    "risk_level": "L1",
    "load": {
      "skills": [{ "name": "gerp-rule-dispatcher", "lines": 50 }]
    },
    "pre_checks": [
      "先判定风险等级 L0-L3",
      "搜索本项目同类实现（路由/菜单 -> Vue 页面/共享组件 -> service/API -> Controller/Service/Mapper/XML -> FieldPackage/权限/菜单 -> 数据库 -> 已有脚本/测试）"
    ]
  },
  "entries": [
    {
      "id": "route-backend-service",
      "title": "后端开发（Service / Controller / Entity / Mapper / SQL / 编译 / 启动）",
      "match": {
        "keywords": ["Service", "Controller", "Entity", "Mapper", "SQL", "编译", "启动", "接口"],
        "paths": ["backend/"]
      },
      "risk_level": "L2",
      "load": {
        "skills": [{ "name": "gerp-command-executor", "lines": 50 }],
        "rules": [
          { "file": ".trae/rules/project_rules.md", "sections": ["数据库配置", "SQL脚本规范", "开发规范和工具链"] }
        ],
        "handbooks": ["docs/项目知识体系/04_开发手册"]
      },
      "pre_checks": ["后端编译通过", "接口实际返回核对"],
      "gates": ["G-CONTRACT-REGISTRY", "G-BUSINESS-FLOW-API"],
      "notes": "L3 升级条件：涉及 Schema / 租户 / 发布 / 正式版闭环时读规则全量"
    },
    {
      "id": "route-frontend-vue",
      "title": "前端开发（Vue / 组件 / 路由 / 接口封装 / 字段配置 / 表单）",
      "match": {
        "keywords": ["Vue", "组件", "页面", "路由", "字段配置", "表单"],
        "paths": ["frontend/"]
      },
      "risk_level": "L1",
      "load": {
        "skills": [{ "name": "vue-best-practices", "lines": 50 }],
        "rules": [{ "file": ".trae/rules/project_rules.md", "sections": [] }],
        "handbooks": ["docs/项目知识体系/04_开发手册"]
      },
      "pre_checks": ["检查共享组件与 composable 是否已有同类实现"],
      "gates": ["G-CONSUMER-FRONTEND", "G-FRONTEND-BUDGET"],
      "notes": "实际修改 Vue/Pinia/路由/状态管理时再展开 vue、vue-pinia-best-practices；母版明文禁止默认全量加载这三个技能"
    },
    {
      "id": "route-page-field-atomic",
      "title": "页面新增/修改、字段增删、原子组件、字段包、元数据",
      "match": {
        "keywords": ["页面新增", "页面修改", "字段增删", "原子组件", "字段包", "FieldPackage", "field_metadata", "page_config"],
        "paths": ["frontend/", "database/"]
      },
      "risk_level": "L2",
      "load": {
        "skills": [
          { "name": "gerp-atomic-component-fieldpackage", "full": true },
          { "name": "vue-best-practices", "lines": 50 }
        ],
        "code_entrypoints": [
          "frontend/gerp-web/src/composables/useFieldPackage.ts",
          "frontend/gerp-web/src/composables/useBusinessFieldConfig.ts",
          "frontend/gerp-web/src/types/fieldGlobalConfig.ts",
          "frontend/gerp-web/src/utils/fieldGlobalConfig.ts"
        ],
        "handbooks": ["docs/项目知识体系/03_架构与唯一真相"]
      },
      "pre_checks": ["字段真相源层次核对（数据库 -> 元数据 -> 组件绑定 -> 个性化）"],
      "gates": ["G-FIELDPACKAGE-COVERAGE", "G-CONSUMER-FRONTEND"]
    },
    {
      "id": "route-foundation-version",
      "title": "版本/模块/插件/菜单/路由/统一登录/租户功能开关/租户权限/AccessProfile/正式版闭环",
      "match": {
        "keywords": ["版本", "模块", "插件", "菜单", "统一登录", "租户功能开关", "租户权限", "AccessProfile", "正式版闭环", "Schema 同步"]
      },
      "risk_level": "L3",
      "load": {
        "skills": [{ "name": "gerp-stable-foundation-governor", "full": true }],
        "rules": [{ "file": ".trae/rules/project_rules.md", "full": true }],
        "handbooks": ["docs/项目知识体系/03_架构与唯一真相"]
      },
      "pre_checks": ["先判定唯一真相与闭环状态，再进入代码或页面修改"],
      "gates": ["G-5S-ENTER", "G-ARCHITECTURE-IMPACT"]
    },
    {
      "id": "route-database",
      "title": "数据库 / MySQL / SQL 脚本",
      "match": {
        "keywords": ["数据库", "MySQL", "SQL脚本", "Schema", "迁移"],
        "paths": ["sql/", "database/"]
      },
      "risk_level": "L3",
      "load": {
        "skills": [{ "name": "mysql-best-practices", "full": true }],
        "rules": [{ "file": ".trae/rules/project_rules.md", "sections": ["数据库配置", "SQL脚本规范"] }],
        "handbooks": ["docs/项目知识体系/03_架构与唯一真相"]
      },
      "pre_checks": ["SHOW TABLES / DESCRIBE 核对现状", "schema 与模板一致性比对"],
      "gates": ["G-DB-GATE", "G-PROD-MIGRATION"]
    },
    {
      "id": "route-uiux",
      "title": "UI / UX / 设计 / 页面美观",
      "match": { "keywords": ["UI", "UX", "设计", "页面美观", "样式"] },
      "risk_level": "L1",
      "load": {
        "skills": [
          { "name": "gerp-ui-ux", "lines": 50 },
          { "name": "tailwind-css-patterns", "lines": 50 }
        ]
      },
      "gates": ["G-CONSUMER-FRONTEND"],
      "notes": "涉及页面结构、报表规范、表格壳或动作语义时再读 ui-ux 引用文档"
    },
    {
      "id": "route-architecture",
      "title": "跨域 / 单体 / 架构 / 域服务",
      "match": { "keywords": ["跨域", "单体", "架构", "域服务", "领域边界"] },
      "risk_level": "L2",
      "load": {
        "skills": [{ "name": "gerp-architect-governor", "lines": 50 }],
        "handbooks": ["docs/项目知识体系/03_架构与唯一真相"]
      },
      "gates": ["G-ARCHITECTURE-IMPACT"]
    },
    {
      "id": "route-business-flow",
      "title": "业务流程 / 审批 / 单据流转",
      "match": { "keywords": ["业务流程", "审批", "单据流转", "保存", "审核", "收货", "入库", "发货", "出库", "记账", "红冲"] },
      "risk_level": "L2",
      "load": {
        "skills": [{ "name": "gerp-flow-closure-audit", "lines": 50 }],
        "handbooks": ["docs/项目知识体系/02_业务手册"]
      },
      "pre_checks": ["无契约先专项核验，不得凭页面文案或旧日志补写业务逻辑"],
      "gates": ["G-DOC-STATUS-ACTION", "G-RUNTIME-REPLAY", "G-BUSINESS-FLOW-API"]
    },
    {
      "id": "route-cross-module",
      "title": "跨模块复杂任务",
      "match": { "keywords": ["跨模块", "多模块", "重构", "批量改造"] },
      "risk_level": "L3",
      "load": {
        "skills": [
          { "name": "gerp-task-decomposer", "lines": 50 },
          { "name": "gerp-rule-dispatcher", "lines": 50 }
        ]
      },
      "pre_checks": ["冻结范围与批次", "标记依赖与回滚点"]
    },
    {
      "id": "route-bug-release",
      "title": "Bug / 稳定版 / 候选版 / 回归 / 发布 / tag / 部署 / 回滚",
      "match": { "keywords": ["Bug", "稳定版", "候选版", "回归", "发布", "tag", "部署", "回滚"] },
      "risk_level": "L3",
      "load": {
        "handbooks": [
          "docs/项目知识体系/05_质量与发布",
          "docs/项目知识体系/06_运行与事故"
        ]
      },
      "pre_checks": [
        "Bug 归属由「稳定基线能否复现」决定，不由发现地点决定",
        "运行 scripts/ps1/resolve-5s-delivery-route.ps1 留下可核验结论"
      ],
      "gates": ["G-5S-ENTER", "G-5S-CLOSE", "G-RELEASE-MANIFEST", "G-ARTIFACT-PROVENANCE", "G-RUNTIME-REPLAY"]
    },
    {
      "id": "route-sales-scope",
      "title": "客户定位 / 销售承诺 / 版本范围 / 模块能否销售 / 产品帮助",
      "match": { "keywords": ["销售", "客户定位", "版本范围", "能否销售", "产品帮助", "可售"] },
      "risk_level": "L2",
      "load": {
        "handbooks": ["docs/项目知识体系/01_产品与销售边界"],
        "rules": [{ "file": ".trae/rules/project_rules.md", "sections": [] }]
      },
      "pre_checks": ["读销售资格矩阵（S0–S3），不得只凭编译/CI/页面加载下结论"],
      "gates": ["G-RELEASE-MANIFEST"]
    },
    {
      "id": "route-decision-record",
      "title": "设计冲突 / 历史原因 / 废弃或迁移决定",
      "match": { "keywords": ["设计冲突", "历史原因", "废弃", "迁移决定", "为什么这么做"] },
      "risk_level": "L1",
      "load": { "handbooks": ["docs/项目知识体系/07_决策与追溯台账"] }
    },
    {
      "id": "route-requirement-delivery",
      "title": "需求 / 客户反馈 / 优先级 / 版本计划 / 发版说明 / 系统公告",
      "match": { "keywords": ["需求", "客户反馈", "优先级", "版本计划", "发版说明", "系统公告"] },
      "risk_level": "L2",
      "load": { "handbooks": ["docs/项目知识体系/08_需求与交付"] },
      "notes": "发版说明与公告只消费已验证、已发布或明确限制的内容"
    }
  ]
}
